# Copia este archivo como apps/core/.env y ajusta los valores.
NODE_ENV=development

# Puerto HTTP de Pulso Core.
PORT=3000

# Base PostgreSQL dedicada al desarrollo.
# Con compose.yaml: postgres://pulso:pulso@localhost:5432/mydas_pulso
DATABASE_URL=postgres://pulso:pulso@localhost:5432/mydas_pulso

# Origen(es) de Pulso Web permitidos por CORS, separados por comas.
WEB_ORIGIN=http://localhost:5173
